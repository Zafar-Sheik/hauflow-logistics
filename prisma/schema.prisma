generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  OWNER
  ADMIN
  OPERATIONS
  FINANCE
  VIEWER
}

enum JobStatus {
  DRAFT
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  INVOICED
  CLOSED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PART_PAID
  PAID
  OVERDUE
  VOID
}

enum SettlementStatus {
  AWAITING_DELIVERY
  READY_TO_PAY
  PAID
  ON_HOLD
  VOID
}

enum PaymentMethod {
  EFT
  CASH
  CARD
  OTHER
}

enum PaymentStatus {
  ACTIVE
  VOID
}

model Organization {
  id                  String              @id @default(cuid())
  name                String
  tradingName         String?
  logoUrl             String?
  registrationNumber  String?
  vatNumber           String?
  vatRegistered       Boolean             @default(false)
  email               String?
  phone               String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  province            String?
  postalCode          String?
  bankName            String?
  bankAccountName     String?
  bankAccountNumber   String?
  bankBranchCode      String?
  bankAccountType     String?
  paymentInstructions String?
  invoiceFooter       String?
  currency            String              @default("ZAR")
  defaultPaymentDays  Int                 @default(30)
  users               User[]
  sessions            Session[]
  customers           Customer[]
  carriers            Carrier[]
  jobs                Job[]
  invoices            Invoice[]
  payments            Payment[]
  settlements         CarrierSettlement[]
  counters            DocumentCounter[]
  auditLogs           AuditLog[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String       @unique
  passwordHash   String
  role           UserRole     @default(OPERATIONS)
  isActive       Boolean      @default(true)
  auditLogs      AuditLog[]
  sessions       Session[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, role])
}

model Session {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique @db.VarChar(64)
  expiresAt      DateTime
  lastUsedAt     DateTime     @default(now())
  userAgent      String?      @db.VarChar(500)
  ipAddress      String?      @db.VarChar(64)
  createdAt      DateTime     @default(now())

  @@index([userId, expiresAt])
  @@index([organizationId, expiresAt])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  registrationNo String?
  vatNumber      String?
  billingEmail   String
  phone          String?
  address        String?      @db.Text
  paymentTerms   Int          @default(30)
  isActive       Boolean      @default(true)
  jobs           Job[]
  invoices       Invoice[]
  payments       Payment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, name])
}

model Carrier {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code               String
  name               String
  registrationNo     String?
  vatNumber          String?
  contactName        String?
  email              String?
  phone              String?
  bankName           String?
  bankAccountName    String?
  bankAccountLast4   String?
  bankVerifiedAt     DateTime?
  insuranceExpiresAt DateTime?
  isActive           Boolean             @default(true)
  jobs               Job[]
  settlements        CarrierSettlement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, name])
}

model Job {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobNumber         String
  customerId        String
  customer          Customer           @relation(fields: [customerId], references: [id])
  carrierId         String?
  carrier           Carrier?           @relation(fields: [carrierId], references: [id])
  status            JobStatus          @default(DRAFT)
  origin            String
  destination       String
  loadDate          DateTime
  deliveryDate      DateTime?
  description       String             @db.Text
  customerReference String?
  vehicleReg        String?
  driverName        String?
  driverPhone       String?
  customerAmount    Decimal            @db.Decimal(14, 2)
  carrierAmount     Decimal            @db.Decimal(14, 2)
  podUrl            String?
  podReceivedAt     DateTime?
  notes             String?            @db.Text
  invoiceLines      InvoiceLine[]
  settlement        CarrierSettlement?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([organizationId, jobNumber])
  @@index([organizationId, status, loadDate])
  @@index([customerId])
  @@index([carrierId])
}

model Invoice {
  id               String              @id @default(cuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber    String
  customerId       String
  customer         Customer            @relation(fields: [customerId], references: [id])
  status           InvoiceStatus       @default(DRAFT)
  issueDate        DateTime
  dueDate          DateTime
  subtotal         Decimal             @db.Decimal(14, 2)
  taxAmount        Decimal             @default(0) @db.Decimal(14, 2)
  total            Decimal             @db.Decimal(14, 2)
  notes            String?             @db.Text
  sentAt           DateTime?
  documentSnapshot Json?
  lines            InvoiceLine[]
  allocations      PaymentAllocation[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, dueDate])
  @@index([customerId])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id])
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(14, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@index([jobId])
}

model Payment {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer            @relation(fields: [customerId], references: [id])
  paymentNumber  String
  paymentDate    DateTime
  amount         Decimal             @db.Decimal(14, 2)
  method         PaymentMethod       @default(EFT)
  status         PaymentStatus       @default(ACTIVE)
  reference      String
  notes          String?             @db.Text
  allocations    PaymentAllocation[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  voidedAt       DateTime?
  voidReason     String?

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, paymentDate])
  @@index([customerId])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model CarrierSettlement {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settlementNumber String
  jobId            String           @unique
  job              Job              @relation(fields: [jobId], references: [id])
  carrierId        String
  carrier          Carrier          @relation(fields: [carrierId], references: [id])
  status           SettlementStatus @default(AWAITING_DELIVERY)
  amount           Decimal          @db.Decimal(14, 2)
  dueDate          DateTime
  paidDate         DateTime?
  paymentReference String?
  holdReason       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([organizationId, settlementNumber])
  @@index([organizationId, status, dueDate])
  @@index([carrierId])
}

model DocumentCounter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType   String
  prefix         String
  nextNumber     Int          @default(1)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, documentType])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String
  beforeJson     Json?
  afterJson      Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([userId, createdAt])
}
